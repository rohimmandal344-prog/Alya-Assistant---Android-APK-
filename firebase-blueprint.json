{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID matching auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "photoUrl": { "type": "string", "description": "User avatar photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "createdAt", "updatedAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Long-term human-like memory item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique memory identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "category": { "type": "string", "description": "Category or topic" },
        "content": { "type": "string", "description": "Memory text content" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "category", "content", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User document storing settings and profile"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/Memory" },
      "description": "User memories collection"
    }
  }
}
